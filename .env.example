# gnu.in.labs / diagram studio — environment
#
# Everything here is OPTIONAL. With an empty file the app runs on its own disk
# and asks each visitor for their own OpenAI key. Filling a block below swaps
# that default for a shared one.
#
# Copy to .env.local. Nothing here is read by the browser: the browser bundle
# only ever sees the NEXT_PUBLIC_ values.

# ─── Generation ───────────────────────────────────────────────────────────────
# Whose key pays for a diagram. Empty means: the visitor pastes their own key,
# stored in a sealed cookie and never readable by JavaScript.
OPENAI_API_KEY=

# OPTIONAL: openai (default) or openrouter. With openrouter, set its key too.
AI_PROVIDER=openai
OPENAI_MODEL=gpt-6-luna

OPENROUTER_API_KEY=
# OPTIONAL: model and the app name OpenRouter shows in its dashboard.
OPENROUTER_MODEL=
OPENROUTER_APP_NAME=gnu.in.labs diagram studio
OPENROUTER_SITE_URL=

# OPTIONAL: per-IP and per-network request limits. The defaults suit a single
# user on one machine; they exist so a loopback server still refuses a runaway
# script.
GENERATION_RATE_LIMIT_MAX=
GENERATION_RATE_LIMIT_WINDOW_SECONDS=
GENERATION_INFRASTRUCTURE_RATE_LIMIT_MAX=
GENERATION_INFRASTRUCTURE_RATE_LIMIT_WINDOW_SECONDS=
MCP_RATE_LIMIT_MAX=
MCP_RATE_LIMIT_WINDOW_SECONDS=

# OPTIONAL: a daily token cap on the server account's key, so one visitor
# cannot spend it all. Leave false to spend it without an application quota.
OPENAI_COMPLIMENTARY_GATE_ENABLED=false
OPENAI_COMPLIMENTARY_DAILY_LIMIT_TOKENS=10000000
OPENAI_COMPLIMENTARY_MODEL_FAMILY=gpt-6-luna

# OPTIONAL: a local model instead of a hosted one (Ollama or llama.cpp).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.6:35b-studio

# OPTIONAL: the typed-judgment service the graph stage can ask for help.
TYPESAFE_API_KEY=
JEV_API_KEY=

# ─── Storage ──────────────────────────────────────────────────────────────────
# Where a finished diagram is kept. Unset means ~/.cache/gnu-in-labs-diagram-studio
# on this machine. Setting R2 moves artifacts to Cloudflare R2 instead.
# CACHE_KEY_SECRET signs the storage namespaces: 32+ random characters.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
CACHE_KEY_SECRET=

# OPTIONAL: Redis, for the shared rate limits and the diagram caches. Unset
# means local disk, which is fine for a single user.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Private repositories ─────────────────────────────────────────────────────
# OPTIONAL: read a repository that is not public. Either paste a token in the
# dialog (recommended: nothing to deploy) or point the app at a GitHub App.
GITHUB_CONNECT=
GITHUB_CONNECT_APP_ID=
GITHUB_CONNECT_CLIENT_ID=
GITHUB_CONNECT_CLIENT_SECRET=
GITHUB_CONNECT_APP_SLUG=
# OPTIONAL: read private repositories server-side instead of through the dialog.
GITHUB_PAT=
GITHUB_PATS=
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=
NEXT_PUBLIC_GITHUB_CONNECT=

# ─── The app's own addresses ──────────────────────────────────────────────────
# OPTIONAL: overrides for a reverse proxy or tunnel in front of the app.
PORT=3000
SITE_URL=http://127.0.0.1:3000
MCP_URL=
MCP_APP_ORIGIN=

# OPTIONAL: UI language, en (default) or fr.
APP_LANG=en

# OPTIONAL: the token OpenAI's plugin portal issued, served at
# /.well-known/openai-apps-challenge so it can verify the local origin.
OPENAI_APPS_CHALLENGE=

# Desktop build only: where Electron keeps its user data.
DIAGRAM_USER_DATA=

# OPTIONAL: move the diagram cache somewhere other than
# ~/.cache/gnu-in-labs-diagram-studio.
DIAGRAM_STUDIO_CACHE_DIR=