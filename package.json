{
  "name": "gnu-in-labs-diagram-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "bun run build:mcp-app && bun run --bun next build",
    "build:electron": "ELECTRON_BUILD=1 bun run build && node scripts/prepare-standalone.mjs",
    "build:mcp-app": "node scripts/build-mcp-app.mjs",
    "electron:build": "bun run build:electron && electron-builder --config electron-builder.json",
    "electron:dev": "node scripts/electron-dev.mjs",
    "verify": "bun run format:check && bun run lint && bun run typecheck && bun run knip && bun run test && bun run test",
    "check": "bun run lint && bun run typecheck",
    "dev": "bun run build:mcp-app && ./scripts/dev-turbo.sh",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings 0",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "preview": "next build && next start",
    "start": "next start",
    "quota:today": "bun scripts/complimentary-quota-today.mjs",
    "browse:migrate-index": "bun scripts/migrate-browse-index.ts",
    "ai-visibility:run": "bun --conditions=react-server scripts/ai-visibility-run.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p electron/tsconfig.json",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx,css,json,jsonc,yml,yaml}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx,css,json,jsonc,yml,yaml}\" --cache",
    "perf:budget": "node scripts/check-performance-budgets.mjs",
    "check:video-tracing": "node scripts/check-video-render-tracing.mjs",
    "knip": "knip --reporter compact",
    "prepare": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/server": "^2.2.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@typesafe-ai/sdk": "^0.6.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.16",
    "geist": "^1.7.2",
    "lucide-react": "^1.48.0",
    "mermaid": "^12.0.0",
    "next": "^16.3.6",
    "openai": "^7.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "browserslist": "4.28.8",
    "ajv": "6.15.0",
    "brace-expansion": "5.0.12",
    "dompurify": "3.4.16",
    "esbuild": "0.28.1",
    "eslint": "10.11.0",
    "fflate": "0.4.9",
    "flatted": "3.4.2",
    "lodash-es": "^4.18.1",
    "minimatch@<4": "3.1.5",
    "picomatch@<3": "2.3.2",
    "postcss": "8.5.28",
    "rollup": "4.62.2",
    "sharp": "0.35.4",
    "undici": "8.11.2",
    "vite": "7.3.6",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "30.0.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^40.7.0",
    "electron-builder": "^26.0.12",
    "esbuild": "0.28.1",
    "eslint": "^10.11.0",
    "eslint-config-next": "^16.3.6",
    "jsdom": "30.1.1",
    "knip": "6.38.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "redis": "^6.2.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@7.0.2",
    "vitest": "5.0.1"
  },
  "knip": {
    "entry": [
      "src/mcp-app/diagram-view.ts",
      "scripts/vendor-fonts.mjs",
      "scripts/prepare-standalone.mjs",
      "scripts/electron-dev.mjs",
      "electron/main.cjs",
      "electron/preload.cjs"
    ],
    "ignore": [
      "experiments/**",
      "public/video-engine/**",
      "workers/**"
    ],
    "ignoreDependencies": [
      "typescript-7",
      "geist"
    ],
    "ignoreBinaries": [
      "redis-server"
    ]
  },
  "engines": {
    "bun": ">=1.3.14 <2",
    "node": "22.x"
  },
  "packageManager": "bun@1.3.14",
  "patchedDependencies": {
    "minimatch@3.1.5": "patches/minimatch@3.1.5.patch"
  },
  "trustedDependencies": [
    "electron",
    "ffmpeg-static"
  ]
}
